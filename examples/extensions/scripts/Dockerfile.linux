FROM rust:1.97.1-trixie

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates clang cmake git libclang-dev libgeos-dev libssl-dev \
    libprotobuf-dev patchelf pkg-config procps protobuf-compiler python3 python3-pip \
    python3-venv unzip && rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install --break-system-packages --no-cache-dir uv==0.12.19 \
    && uv python install 3.12
RUN rustup component add rustfmt clippy \
    && rustup toolchain install nightly-2026-05-28 --profile minimal --component rustfmt
ENV CARGO_INCREMENTAL=0 CARGO_PROFILE_DEV_DEBUG=0
WORKDIR /work/sail
